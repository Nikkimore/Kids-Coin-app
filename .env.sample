# NextAuth — generate with `npx auth secret`
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# World Developer Portal (https://developer.worldcoin.org) — App ID for this Mini App
NEXT_PUBLIC_APP_ID=app_staging_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Leaderboard storage — free Redis database at https://upstash.com
# (create a database, then copy its REST URL + token from the dashboard)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Pay 1 WLD to override the leaderboard message — this is real money.
# NEXT_PUBLIC_WLD_RECEIVER_ADDRESS: your own World App wallet address that
#   receives the payments. Get it from World App (Profile > Wallet).
# DEV_PORTAL_API_KEY: from the Developer Portal (Team > API Keys) — used
#   server-side to verify a payment actually completed before granting
#   the override, so leave it OFF the client bundle (no NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_WLD_RECEIVER_ADDRESS=
DEV_PORTAL_API_KEY=
